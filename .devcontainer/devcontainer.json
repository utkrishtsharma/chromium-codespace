{
  "name": "Chromium Codespace",
  "image": "lscr.io/linuxserver/chromium:latest",
  "runArgs": [
    "--shm-size=1gb",
    "--security-opt",
    "seccomp=unconfined",
    "-e", "PUID=1000",
    "-e", "PGID=1000",
    "-e", "TZ=Etc/UTC"
  ],
  "forwardPorts": [3000, 3001],
  "postCreateCommand": "echo 'Chromium container is ready.'"
}
